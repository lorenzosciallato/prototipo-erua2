      "Bash(doas:*)",
      "Bash(mkfs:*)",
      "Bash(dd:*)",
      "Bash(chmod 777:*)",
      "Bash(chown:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fdx:*)",
      "Bash(git filter-branch:*)",
      "Bash(git filter-repo:*)",
      "Bash(git reflog delete:*)",
      "Bash(git gc --prune:*)",
      "Bash(curl -X POST:*)",
