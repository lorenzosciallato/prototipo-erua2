{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "/home/lorenzosciallato/prototipo-erua2/.claude/hooks/salva-html.sh",
            "timeout": 90,
            "statusMessage": "Controllo i segreti e salvo sul repo…"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Edit",
      "Write",
      "Read",
      "Grep",
      "Glob",
      "WebFetch",
      "WebSearch",
      "Bash(node:*)",
      "Bash(python3:*)",
      "Bash(awk:*)",
      "Bash(bash:*)",
      "Bash(sh:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(git:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(rm:*)",
      "Bash(chmod:*)",
      "Bash(touch:*)",
      "Bash(ln:*)",
      "Bash(tar:*)",
      "Bash(zip:*)",
      "Bash(unzip:*)",
      "Bash(pdftotext:*)",
      "Bash(pdfinfo:*)",
      "Bash(qpdf:*)",
      "Bash(pkill:*)",
      "Bash(kill:*)",
      "Bash(robot/giro.sh)",
      "Bash(.claude/hooks/cerca-segreti.sh)"
